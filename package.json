{
  "name": "dsh-font-picker",
  "version": "0.1.0",
  "description": "Japanese font picker for DeepSeek Harness: choose a well-known Japanese font for text/code/terminal from a simple dropdown, with one-click restore to the built-in default stack.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "font",
    "japanese",
    "typography"
  ],
  "license": "MIT",
  "private": true,
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.4.0-0"
    }
  }
}
